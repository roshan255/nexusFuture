# Environment and credentials
MODE=UAT
BINANCE_API_KEY=
BINANCE_API_SECRET=
UAT_BASE_URL=https://demo-fapi.binance.com
ENABLE_LIVE_TRADING=false
LOG_LEVEL=INFO

# Scan, target, and execution mode
SCAN_INTERVAL_SECONDS=60
TARGET_MODE=SMALL
TARGET_PERCENT=1.5
STOP_LOSS_PERCENT=1.0
# SMALL: market entry, target must be 0.5 to 5. LARGE: limit entry, target must be at least 20.
LARGE_LIMIT_OFFSET_PERCENT=0.25
LARGE_LIMIT_EXPIRY_MINUTES=240
LARGE_TRAILING_ENABLED=false
TRAILING_CALLBACK_PERCENT=1.0
TRAILING_ACTIVATION_PERCENT=5.0

# Leverage and position sizing
LEVERAGE=20
LEVERAGE_FALLBACK=USE_MAX
# USE_MAX uses Binance's maximum supported leverage for a symbol; SKIP waits instead.
MARGIN_MODE=FIXED
MARGIN_PER_TRADE_USDT=10
MARGIN_PERCENT=100

# Direction and market quality thresholds
MIN_SCORE=70
MIN_DIRECTION_GAP=8
MIN_24H_ABS_CHANGE_PERCENT=3
MIN_SHORT_TERM_MOVE_PERCENT=0.25
MIN_QUOTE_VOLUME_USDT=5000000
MIN_RELATIVE_VOLUME=1.1
MIN_ATR_PERCENT=0.15
MAX_ATR_PERCENT=5.0
MIN_ADX=18
MAX_SPREAD_PERCENT=0.12
BREAKOUT_LOOKBACK=20
PRE_FILTER_LIMIT=50
DEEP_ANALYSIS_LIMIT=20
ANALYSIS_WORKERS=4

# Risk and frequency controls
COOLDOWN_SECONDS=300
MAX_TRADES_PER_DAY=5
METADATA_CACHE_SECONDS=3600

# Target-first direction backtest
BACKTEST_LOOKBACK_BARS=1000
BACKTEST_HORIZON_BARS=72
BACKTEST_SIGNAL_STEP=12

# Optional news modifier. It never triggers a trade by itself.
NEWS_ENABLED=false
NEWS_API_URL=https://cryptocurrency.cv/api/news
NEWS_API_KEY=
NEWS_MAX_BONUS=8

# Signal weights. Set a weight to 0 to disable that component.
WEIGHT_TREND=14
WEIGHT_MOMENTUM=10
WEIGHT_VOLUME=9
WEIGHT_OPEN_INTEREST=8
WEIGHT_TAKER=8
WEIGHT_ORDERBOOK=7
WEIGHT_FUNDING=4
WEIGHT_MACD=8
WEIGHT_STOCH_RSI=5
WEIGHT_VWAP=7
WEIGHT_BOLLINGER=5
WEIGHT_ADX=8
WEIGHT_MARKET_STRUCTURE=7
WEIGHT_MULTI_TIMEFRAME=10
WEIGHT_TARGET_REACHABILITY=5
WEIGHT_NEWS=0
